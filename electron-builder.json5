{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.magicvoice.ai",
  "asar": false,
  "productName": "Magic-Voice AI",
  "directories": {
    "buildResources": "build",
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "node_modules/.prisma/**/*"
  ],
  "extraResources": [
    {
      "from": "node_modules/.prisma",
      "to": "app/node_modules/.prisma",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "public/voices",
      "to": "voices",
      "filter": [
        "**/*"
      ]
    }
  ],
  "npmRebuild": false,
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.music",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Mac-${version}-${arch}-Installer.${ext}",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Magic-Voice AI requires access to your microphone to record voice samples for custom voice cloning."
    }
  },
  "dmg": {
    "sign": false
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-${arch}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Magic-Voice AI"
  },
  "linux": {
    "icon": "build/icon.png",
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}-${arch}.${ext}"
  }
}
